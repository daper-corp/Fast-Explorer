import { LineEdit, CheckBox, ListView, ScrollView, Palette, Button, ComboBox } from "std-widgets.slint";

export struct Row {
    name: string,
    date: string,
    kind: string,
    size: string,
    selected: bool,
    editing: bool,
    // On the clipboard after Ctrl+X, until it is pasted or replaced.
    cut: bool,
    // Has the Hidden attribute (shown translucent when "Show hidden items" is on).
    hidden: bool,
    // UTF-8 byte length of the name without its extension (pre-selected when renaming).
    stem: int,
    // Folder of a search hit; empty when browsing a folder.
    location: string,
    icon: image,
    // 0..1 used share for drive rows in @tr("This PC"); negative hides the bar.
    usage: float,
    // Search tree: nesting depth, and whether this folder can expand / is expanded.
    depth: int,
    expandable: bool,
    expanded: bool,
}

export struct TabInfo {
    title: string,
}

// One address-bar path suggestion.
export struct Suggest {
    name: string,
    detail: string,
    path: string,
}

export struct Place {
    title: string,
    path: string,
    active: bool,
    removable: bool,
    icon: image,
}

// One folder-name button in the address bar.
export struct Crumb {
    title: string,
    path: string,
}

enum CaptionGlyph {
    minimize,
    maximize,
    restore,
    close,
}

// A minimize / maximize / close button in the custom title bar.
component WindowButton inherits Rectangle {
    in property <CaptionGlyph> kind: CaptionGlyph.minimize;
    callback clicked;

    width: 46px;
    height: 40px;
    background: touch.pressed
        ? (kind == CaptionGlyph.close ? #c50f1f : Palette.foreground.transparentize(0.78))
        : touch.has-hover
        ? (kind == CaptionGlyph.close ? #e81123 : Palette.foreground.transparentize(0.86))
        : transparent;

    // Caption icons are drawn as paths so they stay crisp and identical at every DPI.
    Path {
        x: (root.width - 10px) / 2;
        y: (root.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        fill: transparent;
        stroke: kind == CaptionGlyph.close && (touch.has-hover || touch.pressed) ? white : Palette.foreground;
        stroke-width: 1px;
        commands: kind == CaptionGlyph.minimize
            ? "M 0 7.5 L 10 7.5"
            : kind == CaptionGlyph.maximize
            ? "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z"
            : kind == CaptionGlyph.restore
            ? "M 3.5 0.5 L 9.5 0.5 L 9.5 6.5 M 0.5 3.5 L 6.5 3.5 L 6.5 9.5 L 0.5 9.5 Z"
            : "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> descending;
    in property <length> min-column-width: 60px;
    in property <length> max-column-width: 1200px;
    // The width a double-click on the resize handle snaps the column to.
    in property <length> fit-width: 100px;
    callback clicked;
    callback resize(length);
    callback auto-fit;

    private property <length> drag-start-width: 0px;
    private property <length> drag-start-pointer-x: 0px;

    HorizontalLayout {
        padding-left: 8px;
        spacing: 6px;
        alignment: start;
        Text {
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
            color: Palette.foreground;
        }
        Text {
            text: !root.sorted ? "" : root.descending ? "▼" : "▲";
            font-size: 8px;
            vertical-alignment: center;
            color: Palette.foreground;
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }

    // Drag the right edge to resize the column; double-click it to fit the contents.
    Rectangle {
        x: root.width - 7px;
        width: 7px;
        height: root.height;
        background: transparent;

        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            height: 100%;
            background: divider-touch.has-hover || divider-touch.pressed ? Palette.foreground.transparentize(0.55) : transparent;
        }

        divider-touch := TouchArea {
            mouse-cursor: ew-resize;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    // Absolute pointer position and the width when pressed: the handle moves
                    // while dragging, so a local delta would drift.
                    root.drag-start-width = root.width;
                    root.drag-start-pointer-x = self.absolute-position.x + self.mouse-x;
                }
            }
            moved => {
                if self.pressed {
                    root.resize(clamp(
                        root.drag-start-width + self.absolute-position.x + self.mouse-x - root.drag-start-pointer-x,
                        root.min-column-width,
                        root.max-column-width,
                    ));
                }
            }
            double-clicked => {
                root.auto-fit();
            }
        }
    }
}

// The three-dot "kebab" button for the search options.
component KebabButton inherits Rectangle {
    callback clicked;

    horizontal-stretch: 0;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        cross-axis-alignment: center;
        spacing: 2px;
        Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: Palette.foreground; }
        Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: Palette.foreground; }
        Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: Palette.foreground; }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The settings (gear) button, drawn with the Windows icon font like our native menus.
component GearButton inherits Rectangle {
    callback clicked;

    horizontal-stretch: 0;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;

    Text {
        text: "\u{E713}";
        font-family: "Segoe MDL2 Assets";
        font-size: 15px;
        color: Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A radio-like row used inside the search-options menu (no nested popup needed).
component OptionChoice inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    height: 26px;
    border-radius: 4px;
    background: touch.has-hover ? Palette.foreground.transparentize(0.94) : transparent;

    HorizontalLayout {
        padding-left: 4px;
        spacing: 7px;
        alignment: start;
        // A layout pins a fixed-height child to the top; this wrapper fills the row so the
        // circle can be centered against the text.
        Rectangle {
            width: 14px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 1px;
                border-color: root.selected ? Palette.accent-background : Palette.foreground.transparentize(0.5);
                background: transparent;
                if root.selected: Rectangle {
                    x: 3px;
                    y: 3px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Palette.accent-background;
                }
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: Palette.foreground;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A flat toolbar button that draws the refresh arrow as a path, so it matches
// the arrow buttons' size without depending on a glyph in the UI font.
component RefreshButton inherits Rectangle {
    callback clicked;

    horizontal-stretch: 0;
    min-width: 30px;
    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;

    Path {
        x: (root.width - 16px) / 2;
        y: (root.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: transparent;
        stroke: Palette.foreground;
        stroke-width: 1.3px;
        commands: "M 12.89 6.22 A 5.2 5.2 0 1 1 10.6 3.5 M 8 1.2 L 10.8 3.5 L 8 5.8";
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Back / forward / up arrows drawn as paths (short tail, big wings, like Explorer).
component ArrowButton inherits Rectangle {
    in property <string> commands;
    in property <bool> enabled: true;
    callback clicked;

    horizontal-stretch: 0;
    min-width: 30px;
    height: 30px;
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.4;
    background: root.enabled && touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;

    Path {
        x: (root.width - 16px) / 2;
        y: (root.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: transparent;
        stroke: Palette.foreground;
        stroke-width: 1.3px;
        commands: root.commands;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Yellow favorites star: outline when off, filled when the folder is a favorite.
component StarButton inherits Rectangle {
    in property <bool> active;
    callback clicked;

    horizontal-stretch: 0;
    min-width: 30px;
    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;

    Path {
        x: (root.width - 16px) / 2;
        y: (root.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.active ? #f5b800 : transparent;
        stroke: #f5b800;
        stroke-width: 1.2px;
        commands: "M 8 1.5 L 9.97 5.9 L 14.7 6.4 L 11.2 9.6 L 12.2 14.3 L 8 11.9 L 3.8 14.3 L 4.8 9.6 L 1.3 6.4 L 6.03 5.9 Z";
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A path that keeps its end visible: when it does not fit, the start is cut behind a "…"
// (Slint's own elide only cuts the end).
component TailText inherits Rectangle {
    in property <string> text;
    in property <brush> text-color;
    property <bool> over: full.preferred-width > self.width;

    if root.over: Text {
        x: 0px;
        width: 12px;
        height: root.height;
        text: "…";
        vertical-alignment: center;
        color: root.text-color;
    }
    Rectangle {
        x: root.over ? 12px : 0px;
        width: root.width - self.x;
        height: root.height;
        clip: true;
        full := Text {
            x: min(0px, parent.width - self.preferred-width);
            width: self.preferred-width;
            height: parent.height;
            text: root.text;
            vertical-alignment: center;
            color: root.text-color;
        }
    }
}

// One folder in the address bar; clicking it goes back up to that folder.
component CrumbButton inherits Rectangle {
    in property <string> title;
    callback clicked;

    horizontal-stretch: 0;
    height: 22px;
    border-radius: 4px;
    background: touch.has-hover ? Palette.foreground.transparentize(0.88) : transparent;

    HorizontalLayout {
        padding-left: 3px;
        padding-right: 3px;
        alignment: center;
        Text {
            text: root.title;
            font-size: 13px;
            color: Palette.foreground;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One folder or drive in the sidebar.
component PlaceRow inherits Rectangle {
    in property <Place> place;
    callback open;
    callback open-tab;
    callback remove;
    callback menu;
    callback history(int);

    height: 30px;
    border-radius: 6px;
    background: place.active ? Palette.accent-background.transparentize(0.82) : touch.has-hover || remove-touch.has-hover ? Palette.foreground.transparentize(0.94) : transparent;

    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.open();
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.middle {
                root.open-tab();
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.menu();
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.back {
                root.history(-1);
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.forward {
                root.history(1);
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 8px;
        Image {
            width: 16px;
            source: place.icon;
            image-fit: contain;
        }
        Text {
            text: place.title;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-weight: place.active ? 600 : 400;
            color: Palette.foreground;
        }
        Rectangle {
            width: 20px;
            height: 20px;
            cross-axis-self-alignment: center;
            border-radius: 4px;
            background: remove-touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;
            opacity: place.removable && (touch.has-hover || remove-touch.has-hover) ? 1 : 0;
            Text {
                text: "×";
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Palette.foreground;
            }
            remove-touch := TouchArea {
                enabled: place.removable;
                clicked => {
                    root.remove();
                }
            }
        }
    }
}

component Sidebar inherits Rectangle {
    in property <[Place]> favorites;
    in property <[Place]> drives;
    in property <string> this-pc-path;
    in property <bool> this-pc-active;
    callback open(string);
    callback open-tab(string);
    callback add;
    callback remove(string);
    callback drive-menu(string);
    callback history(int);

    private property <brush> dim: Palette.foreground.transparentize(0.4);

    background: Palette.alternate-background;

    VerticalLayout {
        padding: 8px;
        spacing: 2px;

        HorizontalLayout {
            height: 26px;
            padding-left: 6px;
            padding-right: 4px;
            Text {
                text: @tr("Favorites");
                font-size: 12px;
                color: root.dim;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 4px;
                background: add-touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;
                Text {
                    text: "+";
                    font-size: 16px;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                add-touch := TouchArea {
                    clicked => {
                        root.add();
                    }
                }
            }
        }

        if root.favorites.length == 0: HorizontalLayout {
            height: 20px;
            padding-left: 8px;
            padding-top: 2px;
            Text {
                text: @tr("Press + to add the current folder");
                font-size: 11px;
                color: root.dim;
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 1px;

                for p in root.favorites: PlaceRow {
                    place: p;
                    open => {
                        root.open(p.path);
                    }
                    open-tab => {
                        root.open-tab(p.path);
                    }
                    remove => {
                        root.remove(p.path);
                    }
                    menu => {
                        root.drive-menu(p.path);
                    }
                    history(d) => {
                        root.history(d);
                    }
                }

                Rectangle {
                    height: 12px;
                }

                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: root.this-pc-active
                        ? Palette.accent-background.transparentize(0.82)
                        : pc-touch.has-hover ? Palette.foreground.transparentize(0.94) : transparent;
                    Text {
                        x: 8px;
                        y: 0;
                        height: parent.height;
                        text: @tr("This PC");
                        font-size: 12px;
                        color: root.this-pc-active ? Palette.foreground : root.dim;
                        vertical-alignment: center;
                    }
                    pc-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            root.open(root.this-pc-path);
                        }
                    }
                }

                for d in root.drives: PlaceRow {
                    place: d;
                    open => {
                        root.open(d.path);
                    }
                    open-tab => {
                        root.open-tab(d.path);
                    }
                    menu => {
                        root.drive-menu(d.path);
                    }
                    history(n) => {
                        root.history(n);
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> folder;
    title: root.folder == "" ? "Fast Explorer" : root.folder + " - Fast Explorer";
    icon: @image-url("assets/icon-256.png");
    no-frame: true;
    preferred-width: 1100px;
    preferred-height: 720px;
    background: Palette.background;
    forward-focus: list-focus;

    in property <[TabInfo]> tabs;
    in property <int> active-tab;
    in property <[Row]> rows;
    in property <string> path;
    // How far the address-bar crumbs are scrolled back from their right end (mouse wheel).
    private property <length> crumb-scroll: 0px;
    changed path => {
        self.crumb-scroll = 0px;
    }
    in property <[Crumb]> crumbs;
    // The @tr("This PC") view: drives and user folders instead of a folder listing.
    in property <bool> this-pc;
    in property <string> this-pc-path;
    // Address-bar autocomplete.
    in-out property <[Suggest]> suggestions;
    in-out property <int> suggest-index: -1;
    // The address bar shows folder buttons until clicked; then it is a text field.
    private property <bool> address-editing: false;
    private property <string> address-text;
    in property <string> status;
    // What the user typed for type-ahead, shown as a short toast over the list.
    in property <string> key-hint;
    // The current folder is in the sidebar's favorites (filled star in the toolbar).
    in property <bool> favorite-active;
    in property <bool> search-mode;
    in-out property <string> search-text;
    // Search options, kept per tab.
    in-out property <bool> search-folders: true;
    in-out property <bool> search-files: true;
    in-out property <bool> search-regex: false;
    // 0 = flat list, 1 = tree.
    in-out property <int> search-view: 0;
    private property <bool> search-options-open: false;
    private property <bool> settings-open: false;
    // Settings panel: update check.
    in property <string> app-version;
    in property <string> update-available;
    in property <string> update-status;
    in-out property <bool> show-hidden;
    in-out property <bool> show-ext;
    in-out property <bool> tree-view;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <int> sort-column;
    in property <bool> sort-desc;
    // Widest visible cell in each column, measured by the hidden Text elements below and
    // used to fit a column to its contents on a double-click of the resize handle.
    in property <string> fit-name: @tr("Name");
    in property <string> fit-location: @tr("Location");
    in property <string> fit-date: @tr("Date modified");
    in property <string> fit-kind: @tr("Type");
    in property <string> fit-size: @tr("Size");
    in property <[Place]> favorites;
    in property <[Place]> drives;
    in property <int> drop-row: -1;
    in-out property <bool> rubber-on: false;
    // Set after a native context menu closes: absorbs the click that dismissed it.
    in-out property <bool> click-shield: false;
    in-out property <length> list-y <=> list.content-y;
    out property <length> list-height: list.visible-height;
    out property <length> list-width: list.width;
    out property <length> row-height: 26px;
    // Where the list sits in the window, to place keyboard-opened menus.
    out property <length> list-origin-x: list.absolute-position.x;
    out property <length> list-origin-y: list.absolute-position.y;
    // The address bar's place in the window, for the autocomplete popup.
    out property <length> address-x: address-box.absolute-position.x;
    out property <length> address-y: address-box.absolute-position.y;
    out property <length> address-width: address-box.width;
    out property <length> address-height: address-box.height;
    // The search-options button's place in the window, for its popup.
    out property <length> options-x: search-options-button.absolute-position.x;
    out property <length> options-y: search-options-button.absolute-position.y;
    out property <length> options-height: search-options-button.height;

    callback navigate(string);
    callback search(string);
    callback search-options-changed();
    callback install-update();
    in-out property <string> home-path;
    callback home-changed(string);
    callback home-use-current();
    callback check-update();
    in-out property <int> lang-index;
    callback lang-changed(int);
    callback row-expand(int);
    callback back();
    callback forward();
    callback up();
    callback refresh();
    callback tab-select(int);
    callback tab-close(int);
    callback tab-new();
    callback tab-move(int, int);
    callback favorite-toggle();
    callback sort(int);
    callback row-pressed(int, KeyboardModifiers);
    callback row-clicked(int);
    callback row-middle(int);
    callback row-open(int);
    callback row-menu(int);
    callback row-hover(int);
    callback row-drag(int);
    callback blank-pressed(bool, bool);  // (right button, control held)
    callback rename-done(string, bool);
    callback new-folder();
    callback new-file();
    callback delete-selected();
    callback view-changed();
    callback place-open(string);
    callback place-open-tab(string);
    callback place-add();
    callback place-remove(string);
    callback drive-menu(string);
    callback history(int);
    callback rubber-start(bool);
    callback rubber-move(length, length);
    callback rubber-end();
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();
    // `in-list` is true when the file list has focus; otherwise only global shortcuts apply.
    callback key(KeyEvent, bool) -> bool;
    callback suggest(string);
    callback suggest-cancel();

    public function close-suggestions() {
        root.suggestions = [];
        root.suggest-index = -1;
        root.suggest-cancel();
    }

    public function pick-suggestion(i: int) {
        if (i >= 0 && i < root.suggestions.length) {
            root.address-text = root.suggestions[i].path;
            root.address-editing = false;
            root.close-suggestions();
            root.navigate(root.address-text);
        }
    }

    public function focus-list() {
        root.search-options-open = false;
        root.settings-open = false;
        root.address-editing = false;
        root.address-text = root.path;
        root.close-suggestions();
        list-focus.focus();
    }

    public function focus-address() {
        root.search-options-open = false;
        root.close-suggestions();
        root.address-editing = true;
        root.address-text = root.path;
        address.focus();
        address.select-all();
    }

    public function focus-search() {
        if (root.this-pc) {
            return;
        }
        root.search-options-open = false;
        root.address-editing = false;
        root.address-text = root.path;
        root.close-suggestions();
        search-box.focus();
        search-box.select-all();
    }

    private property <length> w-name: root.search-mode ? 280px : 440px;
    private property <length> w-location: 210px;
    private property <bool> show-location: root.search-mode && root.search-view == 0;
    private property <length> w-date: 150px;
    private property <length> w-kind: 130px;
    private property <length> w-size: 100px;
    private property <length> suggestion-row-height: 28px;
    // Explorer leaves a small strip on each side of the rows where a drag starts a
    // rubber-band selection instead of hitting a row.
    private property <length> list-margin: 6px;
    // Always-blank strips above/below the rows and right of the last column.
    private property <length> list-vmargin: 4px;
    private property <length> blank-right: 24px;
    private property <brush> dim: Palette.foreground.transparentize(0.4);
    // Tab drag-reorder state: the tab being dragged and the slot it would land in.
    private property <int> tab-drag-from: -1;
    private property <int> tab-drag-to: -1;
    // Tabs shrink (down to a minimum) to fit the strip, then the strip scrolls.
    private property <length> tab-w: min(200px, max(96px, (root.width - 244px) / max(root.tabs.length, 1) - 2px));
    private property <bool> tab-dragging: false;

    // The mouse's back/forward buttons work anywhere nothing more specific handles them.
    TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.back {
                root.history(-1);
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.forward {
                root.history(1);
            }
        }
    }

    changed active-tab => {
        let x = root.active-tab * (root.tab-w + 2px);
        if x < -tabs-flick.content-x {
            tabs-flick.content-x = -x;
        } else if x + root.tab-w > -tabs-flick.content-x + tabs-flick.width {
            tabs-flick.content-x = tabs-flick.width - x - root.tab-w;
        }
    }

    FocusScope {
        key-pressed(e) => {
            root.key(e, false) ? EventResult.accept : EventResult.reject
        }

        VerticalLayout {
            // Tabs: the active one is joined to the page below it (same background, accent line,
            // bold title); the others sit back on the darker strip.
            Rectangle {
                height: 40px;
                background: Palette.alternate-background;
            // Drag the window from the empty part of the tab strip. Stop short of the
            // caption buttons so they own every pointer event in their corner.
            WindowMoveArea {
                width: parent.width - 168px;
                height: 100%;
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 200px;
                padding-top: 6px;
                spacing: 2px;
                // Tabs scroll sideways with the wheel once they no longer fit.
                tabs-flick := Flickable {
                    interactive: false;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    max-width: 100000px;
                    preferred-width: 0px;
                    content-width: root.tabs.length * (root.tab-w + 2px) + 34px;
                    HorizontalLayout {
                spacing: 2px;
                for t[i] in root.tabs: Rectangle {
                    width: root.tab-w;
                    opacity: root.tab-dragging && root.tab-drag-from == i ? 0.45 : 1;
                    border-top-left-radius: 8px;
                    border-top-right-radius: 8px;
                    background: i == root.active-tab ? Palette.background : tab-touch.has-hover ? Palette.foreground.transparentize(0.92) : transparent;
                    Rectangle {
                        x: 10px;
                        y: 0;
                        width: parent.width - 20px;
                        height: 2px;
                        border-radius: 1px;
                        background: i == root.active-tab ? Palette.accent-background : transparent;
                    }
                    // Divider between neighbours; hidden next to the active tab.
                    Rectangle {
                        x: parent.width + 1px;
                        y: 11px;
                        width: 1px;
                        height: 18px;
                        background: Palette.foreground.transparentize(0.75);
                        visible: i < root.tabs.length - 1 && i != root.active-tab && i + 1 != root.active-tab;
                    }
                    tab-touch := TouchArea {
                        scroll-event(e) => {
                            tabs-flick.content-x = min(0px, max(tabs-flick.width - tabs-flick.content-width, tabs-flick.content-x + (e.delta-y + e.delta-x)));
                            accept
                        }
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                root.tab-select(i);
                                root.tab-drag-from = i;
                                root.tab-drag-to = -1;
                                root.tab-dragging = false;
                            }
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.middle {
                                root.tab-close(i);
                            }
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.back {
                                root.history(-1);
                            }
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.forward {
                                root.history(1);
                            }
                            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.tab-drag-from == i {
                                if root.tab-dragging && root.tab-drag-to >= 0 && root.tab-drag-to != i {
                                    root.tab-move(i, root.tab-drag-to);
                                }
                                root.tab-drag-from = -1;
                                root.tab-drag-to = -1;
                                root.tab-dragging = false;
                            }
                        }
                        moved => {
                            if root.tab-drag-from == i {
                                let dx = self.mouse-x - self.pressed-x;
                                if root.tab-dragging || abs(dx) > 6px {
                                    root.tab-dragging = true;
                                    let target = i + round(dx / (root.tab-w + 2px));
                                    root.tab-drag-to = min(max(target, 0), root.tabs.length - 1);
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 4px;
                        spacing: 6px;
                        Image {
                            width: 16px;
                            source: @image-url("assets/icon-32.png");
                            image-fit: contain;
                            opacity: i == root.active-tab ? 1 : 0.6;
                        }
                        Text {
                            text: t.title;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-weight: i == root.active-tab ? 600 : 400;
                            color: i == root.active-tab ? Palette.foreground : root.dim;
                        }
                        Rectangle {
                            width: 24px;
                            border-radius: 4px;
                            background: close-touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;
                            // Close button: always on the active tab, on hover for the others.
                            opacity: i == root.active-tab || tab-touch.has-hover || close-touch.has-hover ? 1 : 0;
                            Text {
                                text: "×";
                                font-size: 16px;
                                color: Palette.foreground;
                            }
                            close-touch := TouchArea {
                                clicked => {
                                    root.tab-close(i);
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    width: 32px;
                    border-radius: 6px;
                    background: new-touch.has-hover ? Palette.foreground.transparentize(0.95) : transparent;
                    Text {
                        text: "+";
                        font-size: 16px;
                        color: Palette.foreground;
                    }
                    new-touch := TouchArea {
                        clicked => {
                            root.tab-new();
                        }
                    }
                }
                    }
                }
            }

            // Where the dragged tab would land. Tabs are tab-w wide with 2px between.
            Rectangle {
                visible: root.tab-dragging && root.tab-drag-to >= 0 && root.tab-drag-to != root.tab-drag-from;
                x: 5px + tabs-flick.content-x + (root.tab-drag-to + (root.tab-drag-to > root.tab-drag-from ? 1 : 0)) * (root.tab-w + 2px);
                y: 8px;
                width: 2px;
                height: 28px;
                border-radius: 1px;
                background: Palette.accent-background;
            }

            // A newer release was found by the daily check: one click asks to install it.
            if root.update-available != "": Rectangle {
                x: parent.width - 168px - 118px;
                width: 118px;
                height: parent.height;
                background: Palette.alternate-background;
                Button {
                    text: @tr("Update to v{}", root.update-available);
                    primary: true;
                    clicked => {
                        root.install-update();
                    }
                }
            }

            // Custom window controls (the native title bar is gone).
            Rectangle {
                x: parent.width - 168px;
                width: 168px;
                height: parent.height;
                background: Palette.alternate-background;
                HorizontalLayout {
                    VerticalLayout {
                        alignment: center;
                        settings-button := GearButton {
                            clicked => {
                                root.search-options-open = false;
                                root.settings-open = !root.settings-open;
                            }
                        }
                    }
                    WindowButton {
                        kind: CaptionGlyph.minimize;
                        clicked => {
                            root.window-minimize();
                        }
                    }
                    WindowButton {
                        kind: root.maximized ? CaptionGlyph.restore : CaptionGlyph.maximize;
                        clicked => {
                            root.window-toggle-maximize();
                        }
                    }
                    WindowButton {
                        kind: CaptionGlyph.close;
                        clicked => {
                            root.window-close();
                        }
                    }
                }
            }
            }

            // Navigation + address bar
            HorizontalLayout {
                padding: 6px;
                spacing: 4px;
                cross-axis-alignment: center;
                ArrowButton {
                    commands: "M 13 8 L 3 8 M 7.5 3.5 L 3 8 L 7.5 12.5";
                    enabled: root.can-back;
                    clicked => {
                        root.back();
                    }
                }
                ArrowButton {
                    commands: "M 3 8 L 13 8 M 8.5 3.5 L 13 8 L 8.5 12.5";
                    enabled: root.can-forward;
                    clicked => {
                        root.forward();
                    }
                }
                ArrowButton {
                    commands: "M 8 13 L 8 3 M 3.5 7.5 L 8 3 L 12.5 7.5";
                    clicked => {
                        root.up();
                    }
                }
                RefreshButton {
                    clicked => {
                        root.refresh();
                    }
                }
                address-box := Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    border-radius: 6px;
                    background: Palette.background;
                    border-width: 1px;
                    border-color: root.address-editing ? Palette.accent-background : Palette.foreground.transparentize(0.82);

                    address := LineEdit {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 32px;
                        height: parent.height - 2px;
                        text <=> root.address-text;
                        edited(t) => {
                            root.suggest(t);
                        }
                        accepted(t) => {
                            if (root.suggest-index >= 0) {
                                root.pick-suggestion(root.suggest-index);
                            } else {
                                root.address-editing = false;
                                root.close-suggestions();
                                root.navigate(t);
                            }
                        }
                        key-pressed(e) => {
                            if (root.suggestions.length > 0) {
                                if (e.text == Key.DownArrow) {
                                    root.suggest-index = root.suggest-index + 1 < root.suggestions.length ? root.suggest-index + 1 : 0;
                                    return accept;
                                }
                                if (e.text == Key.UpArrow) {
                                    root.suggest-index = root.suggest-index <= 0 ? root.suggestions.length - 1 : root.suggest-index - 1;
                                    return accept;
                                }
                                if (e.text == Key.Escape) {
                                    root.close-suggestions();
                                    return accept;
                                }
                            }
                            if e.text == Key.Escape {
                                root.address-editing = false;
                                root.address-text = root.path;
                                root.focus-list();
                                return accept;
                            }
                            reject
                        }
                        changed has-focus => {
                            if !self.has-focus && root.address-editing {
                                root.address-editing = false;
                                root.address-text = root.path;
                                root.close-suggestions();
                            }
                        }
                    }

                    // Folder buttons; the empty area switches to typing.
                    if !root.address-editing: Rectangle {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 32px;
                        height: parent.height - 2px;
                        border-radius: 5px;
                        background: Palette.background;
                        clip: true;

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: text;
                            clicked => {
                                root.focus-address();
                            }
                        }

                        // Too long: crumbs keep their full width and the row slides left so the
                        // last folders stay visible; the cut-off start shows as "…". The wheel
                        // scrolls back toward the start; a new folder starts at the right end.
                        property <bool> crumbs-over: crumb-row.preferred-width > self.width;
                        property <length> crumb-max: max(0px, crumb-row.preferred-width - crumb-clip.width);
                        property <length> crumb-offset: min(root.crumb-scroll, crumb-max);
                        if crumbs-over && crumb-offset < crumb-max: Text {
                            x: 8px;
                            width: 14px;
                            height: parent.height;
                            text: "…";
                            vertical-alignment: center;
                            color: root.dim;
                        }
                        crumb-clip := Rectangle {
                            x: crumbs-over ? 22px : 0px;
                            width: parent.width - self.x;
                            height: parent.height;
                            clip: true;

                            TouchArea {
                                mouse-cursor: text;
                                clicked => {
                                    root.focus-address();
                                }
                                scroll-event(e) => {
                                    if (!crumbs-over) {
                                        return reject;
                                    }
                                    // Wheel up / left reveals the start of the path.
                                    root.crumb-scroll = max(0px, min(crumb-max, crumb-offset + (e.delta-x != 0 ? e.delta-x : e.delta-y)));
                                    accept
                                }

                                crumb-row := HorizontalLayout {
                                    x: min(0px, crumb-clip.width - self.preferred-width) + crumb-offset;
                                    width: self.preferred-width;
                                    height: parent.height;
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    spacing: 0px;
                                    alignment: start;

                                    for c[i] in root.crumbs: HorizontalLayout {
                                        spacing: 0px;
                                        alignment: start;
                                        // Inner box is 28px tall; crumbs are 22px, so center both the same way.
                                        padding-top: 3px;
                                        if i > 0: Text {
                                            width: 8px;
                                            height: 22px;
                                            text: "\\";
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            color: root.dim;
                                        }
                                        CrumbButton {
                                            title: c.title;
                                            clicked => {
                                                root.place-open(c.path);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    StarButton {
                        x: parent.width - 31px;
                        width: 30px;
                        y: 0px;
                        height: parent.height;
                        active: root.favorite-active;
                        clicked => {
                            root.favorite-toggle();
                        }
                    }
                }
                // Narrow until it is clicked (focused) or holds a query.
                search-box := LineEdit {
                    property <bool> wide: self.has-focus || root.search-text != "";
                    width: wide ? 340px : 170px;
                    animate width { duration: 120ms; easing: ease-out; }
                    enabled: !root.this-pc;
                    placeholder-text: root.this-pc
                        ? @tr("Search folders only")
                        : wide ? @tr("Search (current + subfolders) · space AND · ; OR") : @tr("Search");
                    text <=> root.search-text;
                    edited(t) => {
                        root.search(t);
                    }
                }
                search-options-button := KebabButton {
                    clicked => {
                        root.search-options-open = !root.search-options-open;
                    }
                }
            }

            // Sidebar + file list
            HorizontalLayout {
                vertical-stretch: 1;

                Sidebar {
                    width: 196px;
                    vertical-stretch: 1;
                    favorites: root.favorites;
                    drives: root.drives;
                    this-pc-path: root.this-pc-path;
                    this-pc-active: root.this-pc;
                    open(p) => {
                        root.place-open(p);
                    }
                    open-tab(p) => {
                        root.place-open-tab(p);
                    }
                    add => {
                        root.place-add();
                    }
                    remove(p) => {
                        root.place-remove(p);
                    }
                    drive-menu(p) => {
                        root.drive-menu(p);
                    }
                    history(d) => {
                        root.history(d);
                    }
                }
                Rectangle {
                    width: 1px;
                    background: Palette.border;
                }

                VerticalLayout {
                    // Column header
                    header-bar := Rectangle {
                        height: 28px;
                        clip: true;
                        HorizontalLayout {
                            padding-left: root.list-margin + 6px;
                            alignment: start;
                            name-header := HeaderCell {
                                width: root.w-name;
                                min-column-width: 120px;
                                max-column-width: max(120px, header-bar.width - root.list-margin - 7px - root.blank-right);
                                fit-width: max(120px, measure-name.preferred-width + 34px);
                                text: @tr("Name");
                                sorted: root.sort-column == 0;
                                descending: root.sort-desc;
                                clicked => {
                                    root.sort(0);
                                }
                                resize(w) => {
                                    root.w-name = w;
                                }
                                auto-fit => {
                                    root.w-name = min(name-header.max-column-width, name-header.fit-width);
                                }
                            }
                            if root.show-location: location-header := HeaderCell {
                                width: root.w-location;
                                min-column-width: 90px;
                                max-column-width: max(90px, header-bar.width - root.list-margin - 7px - root.blank-right - root.w-name);
                                fit-width: max(90px, measure-location.preferred-width + 24px);
                                text: @tr("Location");
                                resize(w) => {
                                    root.w-location = w;
                                }
                                auto-fit => {
                                    root.w-location = min(location-header.max-column-width, location-header.fit-width);
                                }
                            }
                            date-header := HeaderCell {
                                width: root.w-date;
                                min-column-width: 100px;
                                max-column-width: max(100px, header-bar.width - root.list-margin - 7px - root.blank-right - root.w-name - (root.show-location ? root.w-location : 0px));
                                fit-width: max(100px, measure-date.preferred-width + 22px);
                                text: root.this-pc && !root.search-mode ? @tr("Free space") : @tr("Date modified");
                                sorted: root.sort-column == 1;
                                descending: root.sort-desc;
                                clicked => {
                                    root.sort(1);
                                }
                                resize(w) => {
                                    root.w-date = w;
                                }
                                auto-fit => {
                                    root.w-date = min(date-header.max-column-width, date-header.fit-width);
                                }
                            }
                            kind-header := HeaderCell {
                                width: root.w-kind;
                                min-column-width: 70px;
                                max-column-width: max(70px, header-bar.width - root.list-margin - 7px - root.blank-right - root.w-name - (root.show-location ? root.w-location : 0px) - root.w-date);
                                fit-width: max(70px, measure-kind.preferred-width + 22px);
                                text: @tr("Type");
                                sorted: root.sort-column == 2;
                                descending: root.sort-desc;
                                clicked => {
                                    root.sort(2);
                                }
                                resize(w) => {
                                    root.w-kind = w;
                                }
                                auto-fit => {
                                    root.w-kind = min(kind-header.max-column-width, kind-header.fit-width);
                                }
                            }
                            size-header := HeaderCell {
                                width: root.w-size;
                                min-column-width: 70px;
                                max-column-width: max(70px, header-bar.width - root.list-margin - 7px - root.blank-right - root.w-name - (root.show-location ? root.w-location : 0px) - root.w-date - root.w-kind);
                                fit-width: max(70px, measure-size.preferred-width + 22px);
                                text: root.this-pc && !root.search-mode ? @tr("Total size") : @tr("Size");
                                sorted: root.sort-column == 3;
                                descending: root.sort-desc;
                                clicked => {
                                    root.sort(3);
                                }
                                resize(w) => {
                                    root.w-size = w;
                                }
                                auto-fit => {
                                    root.w-size = min(size-header.max-column-width, size-header.fit-width);
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Palette.border;
                        }
                    }

                    // File list (virtualized: only visible rows are instantiated)
                    list-focus := FocusScope {
                        vertical-stretch: 1;
                        key-pressed(e) => {
                            root.key(e, true) ? EventResult.accept : EventResult.reject
                        }

                        // Clicks that no row takes land here: empty space below the rows.
                        blank-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    if e.button == PointerEventButton.left {
                                        list-focus.focus();
                                        root.blank-pressed(false, e.modifiers.control);
                                        root.rubber-start(e.modifiers.control);
                                        root.rubber-on = true;
                                    }
                                    if e.button == PointerEventButton.back {
                                        root.history(-1);
                                    }
                                    if e.button == PointerEventButton.forward {
                                        root.history(1);
                                    }
                                }
                                // Right-button menus open on release (see the row handler).
                                if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                                    list-focus.focus();
                                    root.blank-pressed(true, false);
                                }
                                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.rubber-on {
                                    root.rubber-on = false;
                                    root.rubber-end();
                                }
                            }
                            moved => {
                                if root.rubber-on {
                                    root.rubber-move(blank-touch.pressed-y - root.list-vmargin, blank-touch.mouse-y - root.list-vmargin);
                                }
                            }

                        list := ListView {
                            x: root.list-margin;
                            y: root.list-vmargin;
                            width: parent.width - 2 * root.list-margin;
                            height: parent.height - root.list-vmargin;
                            // Extra scrollable space so the last row clears the bottom edge.
                            content-height: root.rows.length * root.row-height + root.list-vmargin;
                            for r[i] in root.rows: Rectangle {
                                height: root.row-height;
                                // Columns end before the right edge; what lies beyond acts as blank space.
                                private property <length> cols-w: min(
                                    parent.width - root.blank-right,
                                    6px + root.w-name + (root.show-location ? root.w-location : 0px) + root.w-date + root.w-kind + root.w-size);
                                Rectangle {
                                    x: 0px;
                                    width: parent.cols-w;
                                    background: i == root.drop-row ? Palette.accent-background.transparentize(0.6) : r.selected ? Palette.accent-background.transparentize(list-focus.has-focus ? 0.75 : 0.88) : row-touch.has-hover ? Palette.foreground.transparentize(0.95) : transparent;
                                }

                                row-touch := TouchArea {
                                    x: 0px;
                                    width: parent.cols-w;
                                    pointer-event(e) => {
                                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                            list-focus.focus();
                                            root.row-pressed(i, e.modifiers);
                                        }
                                        // Open on release: pressing right must not leave the
                                        // TouchArea grabbing the mouse while the menu's modal loop runs.
                                        if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                                            list-focus.focus();
                                            root.row-menu(i);
                                        }
                                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.middle {
                                            list-focus.focus();
                                            root.row-middle(i);
                                        }
                                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.back {
                                            root.history(-1);
                                        }
                                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.forward {
                                            root.history(1);
                                        }
                                    }
                                    moved => {
                                        if abs(self.mouse-x - self.pressed-x) > 5px || abs(self.mouse-y - self.pressed-y) > 5px {
                                            root.row-drag(i);
                                        }
                                    }
                                    clicked => {
                                        root.row-clicked(i);
                                    }
                                    double-clicked => {
                                        root.row-open(i);
                                    }
                                    // Prefetch the shell menu for the item under the mouse.
                                    changed has-hover => {
                                        if self.has-hover {
                                            root.row-hover(i);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    alignment: start;
                                    private property <bool> tree-col: root.search-mode || (root.tree-view && !root.this-pc);
                                    private property <length> tree-indent: tree-col ? (14px + r.depth * 14px) : 0px;
                                    if tree-col: Rectangle {
                                        width: r.depth * 14px;
                                    }
                                    if tree-col: Rectangle {
                                        width: 14px;
                                        height: 100%;
                                        // Drawn as a path: the glyph is missing from some UI fonts.
                                        if r.expandable: Path {
                                            x: (parent.width - 8px) / 2;
                                            y: (parent.height - 8px) / 2;
                                            width: 8px;
                                            height: 8px;
                                            viewbox-width: 8;
                                            viewbox-height: 8;
                                            fill: transparent;
                                            stroke: root.dim;
                                            stroke-width: 1.2px;
                                            commands: r.expanded ? "M 0.5 2.5 L 4 6 L 7.5 2.5" : "M 2.5 0.5 L 6 4 L 2.5 7.5";
                                        }
                                        if r.expandable: TouchArea {
                                            clicked => {
                                                list-focus.focus();
                                                root.row-expand(i);
                                            }
                                        }
                                    }
                                    // Cut items wait translucent, like Explorer, until pasted.
                                    opacity: r.cut || r.hidden ? 0.45 : 1;
                                    Image {
                                        width: 16px;
                                        source: r.icon;
                                        image-fit: contain;
                                    }
                                    Rectangle {
                                        width: 6px;
                                    }
                                    if !r.editing: Text {
                                        width: max(0px, root.w-name - 22px - tree-indent);
                                        text: r.name;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        color: Palette.foreground;
                                    }
                                    if r.editing: Rectangle {
                                        width: max(0px, root.w-name - 22px - tree-indent);
                                        // The text stays where the name was drawn; the field's box grows
                                        // 5px to the left of it and stops 10px short of the next column.
                                        Rectangle {
                                            x: -5px;
                                            width: parent.width - 5px;
                                            height: parent.height;
                                            border-radius: 4px;
                                            background: Palette.background;
                                            border-width: 1px;
                                            border-color: Palette.accent-background;
                                            edit-scope := FocusScope {
                                                key-pressed(e) => {
                                                    if e.text == Key.Escape {
                                                        root.rename-done("", false);
                                                        return accept;
                                                    }
                                                    reject
                                                }
                                                edit := TextInput {
                                                    x: 5px;
                                                    width: parent.width - 10px;
                                                    height: parent.height;
                                                    text: r.name;
                                                    color: Palette.foreground;
                                                    vertical-alignment: center;
                                                    single-line: true;
                                                    init => {
                                                        self.focus();
                                                        self.set-selection-offsets(0, r.stem);
                                                    }
                                                    accepted => {
                                                        root.rename-done(self.text, true);
                                                    }
                                                    changed has-focus => {
                                                        if !self.has-focus {
                                                            root.rename-done(self.text, true);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.show-location: TailText {
                                        width: root.w-location;
                                        text: r.location;
                                        text-color: root.dim;
                                    }
                                    Rectangle {
                                        width: root.w-date;
                                        height: parent.height;

                                        Text {
                                            x: 0;
                                            y: 0;
                                            width: parent.width;
                                            height: parent.height - 4px;
                                            text: r.date;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            color: root.dim;
                                        }
                                        if r.usage >= 0.0: Rectangle {
                                            x: 0px;
                                            y: parent.height - 4px;
                                            height: 3px;
                                            width: parent.width;
                                            background: Palette.foreground.transparentize(0.88);
                                            border-radius: 1.5px;
                                        }
                                        if r.usage >= 0.0: Rectangle {
                                            x: 0px;
                                            y: parent.height - 4px;
                                            height: 3px;
                                            width: parent.width * r.usage;
                                            background: Palette.accent-background;
                                            border-radius: 1.5px;
                                        }
                                    }
                                    Text {
                                        width: root.w-kind;
                                        text: r.kind;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        color: root.dim;
                                    }
                                    Text {
                                        width: root.w-size;
                                        text: r.size;
                                        overflow: elide;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        color: root.dim;
                                    }
                                }
                            }
                        }

                        // Rubber-band selection rectangle.
                        Rectangle {
                            visible: root.rubber-on;
                            x: min(blank-touch.pressed-x, blank-touch.mouse-x);
                            y: min(blank-touch.pressed-y, blank-touch.mouse-y);
                            width: abs(blank-touch.mouse-x - blank-touch.pressed-x);
                            height: abs(blank-touch.mouse-y - blank-touch.pressed-y);
                            background: Palette.accent-background.transparentize(0.85);
                            border-width: 1px;
                            border-color: Palette.accent-background;
                        }
                        }

                        // Type-ahead toast: shows exactly what was typed while it jumps to a match.
                        Rectangle {
                            visible: root.key-hint != "";
                            x: (parent.width - self.width) / 2;
                            y: parent.height - 52px;
                            width: min(parent.width - 24px, max(90px, hint-text.preferred-width + 32px));
                            height: 32px;
                            border-radius: 8px;
                            background: Palette.foreground.transparentize(0.08);
                            hint-text := Text {
                                x: 16px;
                                width: parent.width - 32px;
                                height: parent.height;
                                text: root.key-hint;
                                font-size: 14px;
                                color: Palette.background;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            // Status bar
            HorizontalLayout {
                padding: 6px;
                padding-left: 10px;
                Text {
                    text: root.status;
                    color: root.dim;
                }
            }
        }

        // Address-bar autocomplete; a later sibling draws above the page.
        if (root.address-editing && root.suggestions.length > 0): Rectangle {
            x: root.address-x;
            y: min(
                root.address-y + root.address-height + 2px,
                root.height - root.suggestions.length * root.suggestion-row-height - 16px,
            );
            width: root.address-width;
            height: root.suggestions.length * root.suggestion-row-height + 8px;
            background: Palette.background;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.foreground.transparentize(0.75);
            clip: true;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                for s[i] in root.suggestions: Rectangle {
                    height: root.suggestion-row-height;
                    border-radius: 4px;
                    background: i == root.suggest-index
                        ? Palette.accent-background.transparentize(0.65)
                        : suggest-touch.has-hover ? Palette.foreground.transparentize(0.94) : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            width: 240px;
                            text: s.name;
                            overflow: elide;
                            vertical-alignment: center;
                            color: Palette.foreground;
                        }
                        TailText {
                            horizontal-stretch: 1;
                            text: s.detail;
                            text-color: root.dim;
                        }
                    }

                    suggest-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            root.pick-suggestion(i);
                        }
                    }
                }
            }
        }

        // Search options: a small menu anchored under the kebab button.
        if root.search-options-open: TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.search-options-open = false;
            }
        }

        if root.search-options-open: Rectangle {
            x: max(8px, min(root.options-x + search-options-button.width - 228px, root.width - 228px));
            y: root.options-y + root.options-height + 4px;
            width: 220px;
            height: options-panel.preferred-height + 20px;
            background: Palette.background;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.foreground.transparentize(0.65);
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000038;
            drop-shadow-offset-y: 4px;
            clip: true;

            options-panel := VerticalLayout {
                padding: 10px;
                spacing: 5px;

                Text { text: @tr("Search options"); font-size: 13px; color: Palette.foreground; }
                Rectangle { height: 2px; }

                Text { text: @tr("Search in"); font-size: 12px; color: root.dim; }
                CheckBox {
                    text: @tr("Folders");
                    checked <=> root.search-folders;
                    changed checked => {
                        root.search-options-changed();
                    }
                }
                CheckBox {
                    text: @tr("Files");
                    checked <=> root.search-files;
                    changed checked => {
                        root.search-options-changed();
                    }
                }

                Rectangle { height: 4px; }

                Text { text: @tr("Pattern"); font-size: 12px; color: root.dim; }
                CheckBox {
                    text: @tr("Regex");
                    checked <=> root.search-regex;
                    changed checked => {
                        root.search-options-changed();
                    }
                }

                Rectangle { height: 4px; }

                Text { text: @tr("Results view"); font-size: 12px; color: root.dim; }
                OptionChoice {
                    text: @tr("Flat list");
                    selected: root.search-view == 0;
                    clicked => {
                        root.search-view = 0;
                        root.search-options-changed();
                    }
                }
                OptionChoice {
                    text: @tr("Tree");
                    selected: root.search-view == 1;
                    clicked => {
                        root.search-view = 1;
                        root.search-options-changed();
                    }
                }
            }
        }

        // Settings: a small panel anchored under the gear button.
        if root.settings-open: TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.settings-open = false;
            }
        }

        if root.settings-open: Rectangle {
            x: max(8px, min(settings-button.absolute-position.x + settings-button.width - 268px, root.width - 268px));
            y: settings-button.absolute-position.y + settings-button.height + 4px;
            width: 260px;
            height: settings-panel.preferred-height + 20px;
            background: Palette.background;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.foreground.transparentize(0.65);
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000038;
            drop-shadow-offset-y: 4px;
            clip: true;

            settings-panel := VerticalLayout {
                padding: 10px;
                spacing: 5px;

                Text { text: @tr("Settings"); font-size: 13px; color: Palette.foreground; }
                Rectangle { height: 2px; }

                Text { text: @tr("View"); font-size: 12px; color: root.dim; }
                CheckBox {
                    text: @tr("Show hidden items");
                    checked <=> root.show-hidden;
                    changed checked => {
                        root.view-changed();
                    }
                }
                CheckBox {
                    text: @tr("Show file extensions");
                    checked <=> root.show-ext;
                    changed checked => {
                        root.view-changed();
                    }
                }
                CheckBox {
                    text: @tr("Show folders as a tree");
                    checked <=> root.tree-view;
                    changed checked => {
                        root.view-changed();
                    }
                }

                Rectangle { height: 4px; }

                Text { text: @tr("Default folder (startup · new tab)"); font-size: 12px; color: root.dim; }
                home-edit := LineEdit {
                    text <=> root.home-path;
                    placeholder-text: @tr("C:\\ (leave empty for default)");
                    edited(text) => {
                        root.home-changed(text);
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: @tr("Use current folder");
                        clicked => {
                            root.home-use-current();
                        }
                    }
                    Button {
                        text: @tr("Reset");
                        clicked => {
                            root.home-path = "";
                            root.home-changed("");
                        }
                    }
                }

                Rectangle { height: 4px; }

                Text { text: @tr("Language"); font-size: 12px; color: root.dim; }
                ComboBox {
                    model: [@tr("System default"), "English", "한국어"];
                    current-index <=> root.lang-index;
                    selected(v) => {
                        root.lang-changed(root.lang-index);
                    }
                }

                Rectangle { height: 4px; }

                Text { text: @tr("Updates"); font-size: 12px; color: root.dim; }
                Text { text: "Fast Explorer v" + root.app-version; color: Palette.foreground; }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: @tr("Check now");
                        clicked => {
                            root.check-update();
                        }
                    }
                    Text {
                        text: root.update-status;
                        color: root.dim;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        // Off-screen samples for "fit column to contents" (double-click a header divider).
        // Measuring with real Text elements keeps the fit identical to what the rows render.
        Rectangle {
            x: -10000px;
            y: 0px;
            width: 5000px;
            height: 24px;
            opacity: 0;
            clip: true;

            HorizontalLayout {
                alignment: start;
                measure-name := Text {
                    text: root.fit-name;
                }
                measure-location := Text {
                    text: root.fit-location;
                }
                measure-date := Text {
                    text: root.fit-date;
                }
                measure-kind := Text {
                    text: root.fit-kind;
                }
                measure-size := Text {
                    text: root.fit-size;
                }
            }
        }

        // A crisp frame so the window reads as a separate surface. The native DWM
        // frame underneath adds the outer drop shadow.
        Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;
            border-width: 1px;
            border-color: root.maximized ? transparent : Palette.foreground.transparentize(0.6);
        }
    }

    // The left click that dismissed a native context menu: swallow it so a stale pointer
    // position cannot select, open, or start a drag behind the menu.
    if root.click-shield: TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(e) => {
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                root.click-shield = false;
            }
        }
    }
}

// ---------- Batch rename dialog ----------

export struct RenameRow {
    old: string,
    new: string,
    // Empty when fine; otherwise why this row cannot be renamed.
    problem: string,
    changed: bool,
}

export component RenameWindow inherits Window {
    title: @tr("Rename multiple items");
    icon: @image-url("assets/icon-256.png");
    preferred-width: 780px;
    preferred-height: 600px;
    min-width: 560px;
    min-height: 420px;
    background: Palette.background;

    in-out property <string> find;
    in-out property <string> replace;
    in-out property <bool> use-regex: false;
    in-out property <bool> match-case: false;
    in-out property <bool> replace-all: true;
    // 0 = name (without extension), 1 = extension, 2 = whole name
    in-out property <int> part: 0;
    // 0 = keep, 1 = lowercase, 2 = uppercase
    in-out property <int> case-mode: 0;
    in property <[RenameRow]> rows;
    in property <string> summary;
    in property <string> error;
    in property <bool> can-apply;
    in property <bool> busy;
    callback changed();
    callback apply();
    callback cancel();

    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.cancel();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            GridLayout {
                spacing: 8px;
                Row {
                    Text { text: @tr("Find"); vertical-alignment: center; color: Palette.foreground; }
                    LineEdit {
                        text <=> root.find;
                        placeholder-text: @tr("If empty, only the case is changed");
                        edited => { root.changed(); }
                        accepted => { if root.can-apply { root.apply(); } }
                    }
                }
                Row {
                    Text { text: @tr("Replace with"); vertical-alignment: center; color: Palette.foreground; }
                    LineEdit {
                        text <=> root.replace;
                        placeholder-text: @tr("{{n}} = number, {{n:3}} = 001  (regex: $1, $2)");
                        edited => { root.changed(); }
                        accepted => { if root.can-apply { root.apply(); } }
                    }
                }
            }

            HorizontalLayout {
                spacing: 16px;
                CheckBox {
                    text: @tr("Regex");
                    checked <=> root.use-regex;
                    toggled => { root.changed(); }
                }
                CheckBox {
                    text: @tr("Match case");
                    checked <=> root.match-case;
                    toggled => { root.changed(); }
                }
                CheckBox {
                    text: @tr("Replace all");
                    checked <=> root.replace-all;
                    toggled => { root.changed(); }
                }
            }

            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text { text: @tr("Apply to"); vertical-alignment: center; color: Palette.foreground; width: 64px; }
                OptionChoice { width: 110px; text: @tr("Name"); selected: root.part == 0; clicked => { root.part = 0; root.changed(); } }
                OptionChoice { width: 90px; text: @tr("Extension"); selected: root.part == 1; clicked => { root.part = 1; root.changed(); } }
                OptionChoice { width: 90px; text: @tr("All"); selected: root.part == 2; clicked => { root.part = 2; root.changed(); } }
                Rectangle { width: 24px; }
                Text { text: @tr("Case"); vertical-alignment: center; color: Palette.foreground; width: 64px; }
                OptionChoice { width: 80px; text: @tr("Keep"); selected: root.case-mode == 0; clicked => { root.case-mode = 0; root.changed(); } }
                OptionChoice { width: 80px; text: @tr("Lowercase"); selected: root.case-mode == 1; clicked => { root.case-mode = 1; root.changed(); } }
                OptionChoice { width: 80px; text: @tr("Uppercase"); selected: root.case-mode == 2; clicked => { root.case-mode = 2; root.changed(); } }
            }

            Text {
                visible: root.error != "";
                height: root.error == "" ? 0px : self.preferred-height;
                text: root.error;
                color: #e81123;
                wrap: word-wrap;
            }

            // Preview
            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: Palette.foreground.transparentize(0.8);
                border-radius: 4px;
                clip: true;
                ListView {
                    for r in root.rows: Rectangle {
                        height: 26px;
                        background: r.problem != "" ? #e81123.transparentize(0.9) : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                text: r.old;
                                overflow: elide;
                                vertical-alignment: center;
                                color: r.changed ? Palette.foreground.transparentize(0.4) : Palette.foreground;
                            }
                            Text {
                                text: r.changed ? "→" : "";
                                width: 16px;
                                vertical-alignment: center;
                                color: Palette.foreground.transparentize(0.4);
                            }
                            Text {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                text: r.problem != "" ? r.new + "   ⚠ " + r.problem : r.changed ? r.new : "";
                                overflow: elide;
                                vertical-alignment: center;
                                color: r.problem != "" ? #e81123 : Palette.accent-background;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.summary;
                    vertical-alignment: center;
                    color: Palette.foreground.transparentize(0.3);
                }
                Button {
                    text: @tr("Cancel");
                    clicked => { root.cancel(); }
                }
                Button {
                    text: @tr("Rename");
                    primary: true;
                    enabled: root.can-apply && !root.busy;
                    clicked => { root.apply(); }
                }
            }
        }
    }
}

// ---------- "In use by" dialog ----------

export struct LockRow {
    name: string,
    pid: string,
    path: string,
    service: bool,
}

export component LocksWindow inherits Window {
    title: @tr("Processes in use");
    icon: @image-url("assets/icon-256.png");
    preferred-width: 640px;
    preferred-height: 420px;
    min-width: 480px;
    min-height: 260px;
    background: Palette.background;

    in property <string> header;
    in property <string> status;
    in property <[LockRow]> rows;
    in property <bool> busy;
    callback kill(int);
    callback kill-all();
    callback refresh();
    callback cancel();

    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.cancel();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: root.header;
                color: Palette.foreground;
                overflow: elide;
            }

            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: Palette.foreground.transparentize(0.8);
                border-radius: 4px;
                clip: true;
                ListView {
                    for r[i] in root.rows: Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: r.name + "  (PID " + r.pid + ")" + (r.service ? @tr("  · service") : "");
                                    overflow: elide;
                                    color: Palette.foreground;
                                }
                                Text {
                                    text: r.path;
                                    overflow: elide;
                                    font-size: 11px;
                                    color: Palette.foreground.transparentize(0.4);
                                }
                            }
                            Button {
                                text: @tr("End");
                                enabled: !root.busy;
                                clicked => { root.kill(i); }
                            }
                        }
                    }
                }
                if root.rows.length == 0: Text {
                    text: root.busy ? @tr("Searching…") : @tr("No processes are using it");
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Palette.foreground.transparentize(0.4);
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.status;
                    overflow: elide;
                    vertical-alignment: center;
                    color: Palette.foreground.transparentize(0.3);
                }
                Button {
                    text: @tr("Refresh");
                    enabled: !root.busy;
                    clicked => { root.refresh(); }
                }
                Button {
                    text: @tr("End all");
                    enabled: !root.busy && root.rows.length > 0;
                    clicked => { root.kill-all(); }
                }
                Button {
                    text: @tr("Close");
                    primary: true;
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}
