import { LineEdit, CheckBox, ListView, ScrollView, Palette } from "std-widgets.slint";

export struct Row {
    name: string,
    date: string,
    kind: string,
    size: string,
    selected: bool,
    editing: bool,
    // UTF-8 byte length of the name without its extension (pre-selected when renaming).
    stem: int,
    // Folder of a search hit; empty when browsing a folder.
    location: string,
    icon: image,
    // 0..1 used share for drive rows in "내 PC"; negative hides the bar.
    usage: float,
    // Search tree: nesting depth, and whether this folder can expand / is expanded.
    depth: int,
    expandable: bool,
    expanded: bool,
}

export struct TabInfo {
    title: string,
}

// One address-bar path suggestion.
export struct Suggest {
    name: string,
    detail: string,
    path: string,
}

export struct Place {
    title: string,
    path: string,
    active: bool,
    removable: bool,
    icon: image,
}

// One folder-name button in the address bar.
export struct Crumb {
    title: string,
    path: string,
}

enum CaptionGlyph {
    minimize,
    maximize,
    restore,
    close,
}

// A minimize / maximize / close button in the custom title bar.
component WindowButton inherits Rectangle {
    in property <CaptionGlyph> kind: CaptionGlyph.minimize;
    callback clicked;

    width: 46px;
    height: 40px;
    background: touch.pressed
        ? (kind == CaptionGlyph.close ? #c50f1f : Palette.foreground.transparentize(0.78))
        : touch.has-hover
        ? (kind == CaptionGlyph.close ? #e81123 : Palette.foreground.transparentize(0.86))
        : transparent;

    // Caption icons are drawn as paths so they stay crisp and identical at every DPI.
    Path {
        x: (root.width - 10px) / 2;
        y: (root.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        fill: transparent;
        stroke: kind == CaptionGlyph.close && (touch.has-hover || touch.pressed) ? white : Palette.foreground;
        stroke-width: 1px;
        commands: kind == CaptionGlyph.minimize
            ? "M 0 7.5 L 10 7.5"
            : kind == CaptionGlyph.maximize
            ? "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z"
            : kind == CaptionGlyph.restore
            ? "M 3.5 0.5 L 9.5 0.5 L 9.5 6.5 M 0.5 3.5 L 6.5 3.5 L 6.5 9.5 L 0.5 9.5 Z"
            : "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> descending;
    in property <length> min-column-width: 60px;
    in property <length> max-column-width: 1200px;
    // The width a double-click on the resize handle snaps the column to.
    in property <length> fit-width: 100px;
    callback clicked;
    callback resize(length);
    callback auto-fit;

    private property <length> drag-start-width: 0px;
    private property <length> drag-start-pointer-x: 0px;

    HorizontalLayout {
        padding-left: 8px;
        spacing: 6px;
        alignment: start;
        Text {
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
            color: Palette.foreground;
        }
        Text {
            text: !root.sorted ? "" : root.descending ? "▼" : "▲";
            font-size: 8px;
            vertical-alignment: center;
            color: Palette.foreground;
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }

    // Drag the right edge to resize the column; double-click it to fit the contents.
    Rectangle {
        x: root.width - 7px;
        width: 7px;
        height: root.height;
        background: transparent;

        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            height: 100%;
            background: divider-touch.has-hover || divider-touch.pressed ? Palette.foreground.transparentize(0.55) : transparent;
        }

        divider-touch := TouchArea {
            mouse-cursor: ew-resize;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    // Absolute pointer position and the width when pressed: the handle moves
                    // while dragging, so a local delta would drift.
                    root.drag-start-width = root.width;
                    root.drag-start-pointer-x = self.absolute-position.x + self.mouse-x;
                }
            }
            moved => {
                if self.pressed {
                    root.resize(clamp(
                        root.drag-start-width + self.absolute-position.x + self.mouse-x - root.drag-start-pointer-x,
                        root.min-column-width,
                        root.max-column-width,
                    ));
                }
            }
            double-clicked => {
                root.auto-fit();
            }
        }
    }
}

// The three-dot "kebab" button for the search options.
component KebabButton inherits Rectangle {
    callback clicked;

    horizontal-stretch: 0;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        cross-axis-alignment: center;
        spacing: 2px;
        Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: Palette.foreground; }
        Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: Palette.foreground; }
        Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: Palette.foreground; }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A radio-like row used inside the search-options menu (no nested popup needed).
component OptionChoice inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    height: 26px;
    border-radius: 4px;
    background: touch.has-hover ? Palette.foreground.transparentize(0.94) : transparent;

    HorizontalLayout {
        padding-left: 4px;
        spacing: 7px;
        alignment: start;
        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            border-width: 1px;
            border-color: root.selected ? Palette.accent-background : Palette.foreground.transparentize(0.5);
            background: transparent;
            if root.selected: Rectangle {
                x: 3px;
                y: 3px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Palette.accent-background;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: Palette.foreground;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A flat toolbar button: no border or fill until hovered.
component ToolButton inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 13px;
    in property <bool> enabled: true;
    callback clicked;

    horizontal-stretch: 0;
    min-width: max(30px, layout.min-width);
    height: 30px;
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.4;
    background: root.enabled && touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;

    layout := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        alignment: center;
        Text {
            text: root.text;
            font-size: root.font-size;
            color: Palette.foreground;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A flat toolbar button that draws the refresh arrow as a path, so it matches
// the arrow buttons' size without depending on a glyph in the UI font.
component RefreshButton inherits Rectangle {
    callback clicked;

    horizontal-stretch: 0;
    min-width: 30px;
    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;

    Path {
        x: (root.width - 16px) / 2;
        y: (root.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: transparent;
        stroke: Palette.foreground;
        stroke-width: 1.3px;
        commands: "M 12.89 6.22 A 5.2 5.2 0 1 1 10.6 3.5 M 9.65 1.85 L 10.6 3.5 L 8.7 3.5";
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One folder in the address bar; clicking it goes back up to that folder.
component CrumbButton inherits Rectangle {
    in property <string> title;
    callback clicked;

    horizontal-stretch: 0;
    height: 22px;
    border-radius: 4px;
    background: touch.has-hover ? Palette.foreground.transparentize(0.88) : transparent;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;
        Text {
            text: root.title;
            font-size: 13px;
            color: Palette.foreground;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One folder or drive in the sidebar.
component PlaceRow inherits Rectangle {
    in property <Place> place;
    callback open;
    callback remove;
    callback history(int);

    height: 30px;
    border-radius: 6px;
    background: place.active ? Palette.accent-background.transparentize(0.82) : touch.has-hover || remove-touch.has-hover ? Palette.foreground.transparentize(0.94) : transparent;

    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.open();
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.back {
                root.history(-1);
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.forward {
                root.history(1);
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 8px;
        Image {
            width: 16px;
            source: place.icon;
            image-fit: contain;
        }
        Text {
            text: place.title;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-weight: place.active ? 600 : 400;
            color: Palette.foreground;
        }
        Rectangle {
            width: 20px;
            height: 20px;
            cross-axis-self-alignment: center;
            border-radius: 4px;
            background: remove-touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;
            opacity: place.removable && (touch.has-hover || remove-touch.has-hover) ? 1 : 0;
            Text {
                text: "×";
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Palette.foreground;
            }
            remove-touch := TouchArea {
                enabled: place.removable;
                clicked => {
                    root.remove();
                }
            }
        }
    }
}

component Sidebar inherits Rectangle {
    in property <[Place]> favorites;
    in property <[Place]> drives;
    in property <string> this-pc-path;
    in property <bool> this-pc-active;
    callback open(string);
    callback add;
    callback remove(string);
    callback history(int);

    private property <brush> dim: Palette.foreground.transparentize(0.4);

    background: Palette.alternate-background;

    VerticalLayout {
        padding: 8px;
        spacing: 2px;

        HorizontalLayout {
            height: 26px;
            padding-left: 6px;
            padding-right: 4px;
            Text {
                text: "즐겨찾기";
                font-size: 12px;
                color: root.dim;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 4px;
                background: add-touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;
                Text {
                    text: "+";
                    font-size: 16px;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                add-touch := TouchArea {
                    clicked => {
                        root.add();
                    }
                }
            }
        }

        if root.favorites.length == 0: HorizontalLayout {
            height: 20px;
            padding-left: 8px;
            padding-top: 2px;
            Text {
                text: "현재 폴더를 추가하려면 +";
                font-size: 11px;
                color: root.dim;
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 1px;

                for p in root.favorites: PlaceRow {
                    place: p;
                    open => {
                        root.open(p.path);
                    }
                    remove => {
                        root.remove(p.path);
                    }
                    history(d) => {
                        root.history(d);
                    }
                }

                Rectangle {
                    height: 12px;
                }

                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: root.this-pc-active
                        ? Palette.accent-background.transparentize(0.82)
                        : pc-touch.has-hover ? Palette.foreground.transparentize(0.94) : transparent;
                    Text {
                        x: 8px;
                        y: 0;
                        height: parent.height;
                        text: "내 PC";
                        font-size: 12px;
                        color: root.this-pc-active ? Palette.foreground : root.dim;
                        vertical-alignment: center;
                    }
                    pc-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            root.open(root.this-pc-path);
                        }
                    }
                }

                for d in root.drives: PlaceRow {
                    place: d;
                    open => {
                        root.open(d.path);
                    }
                    history(n) => {
                        root.history(n);
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> folder;
    title: root.folder == "" ? "Fast Explorer" : root.folder + " - Fast Explorer";
    icon: @image-url("assets/icon-256.png");
    no-frame: true;
    preferred-width: 1100px;
    preferred-height: 720px;
    background: Palette.background;
    forward-focus: list-focus;

    in property <[TabInfo]> tabs;
    in property <int> active-tab;
    in property <[Row]> rows;
    in property <string> path;
    in property <[Crumb]> crumbs;
    // The "내 PC" view: drives and user folders instead of a folder listing.
    in property <bool> this-pc;
    in property <string> this-pc-path;
    // Address-bar autocomplete.
    in-out property <[Suggest]> suggestions;
    in-out property <int> suggest-index: -1;
    // The address bar shows folder buttons until clicked; then it is a text field.
    private property <bool> address-editing: false;
    private property <string> address-text;
    in property <string> status;
    in property <bool> search-mode;
    in-out property <string> search-text;
    // Search options, kept per tab.
    in-out property <bool> search-folders: true;
    in-out property <bool> search-files: true;
    in-out property <bool> search-regex: false;
    // 0 = 단순 목록, 1 = 트리 구조.
    in-out property <int> search-view: 0;
    private property <bool> search-options-open: false;
    in-out property <bool> show-hidden;
    in-out property <bool> show-ext;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <int> sort-column;
    in property <bool> sort-desc;
    // Widest visible cell in each column, measured by the hidden Text elements below and
    // used to fit a column to its contents on a double-click of the resize handle.
    in property <string> fit-name: "이름";
    in property <string> fit-location: "위치";
    in property <string> fit-date: "수정한 날짜";
    in property <string> fit-kind: "유형";
    in property <string> fit-size: "크기";
    in property <[Place]> favorites;
    in property <[Place]> drives;
    in property <int> drop-row: -1;
    in-out property <bool> rubber-on: false;
    // Set after a native context menu closes: absorbs the click that dismissed it.
    in-out property <bool> click-shield: false;
    in-out property <length> list-y <=> list.content-y;
    out property <length> list-height: list.visible-height;
    out property <length> list-width: list.width;
    out property <length> row-height: 26px;
    // Where the list sits in the window, to place keyboard-opened menus.
    out property <length> list-origin-x: list.absolute-position.x;
    out property <length> list-origin-y: list.absolute-position.y;
    // The address bar's place in the window, for the autocomplete popup.
    out property <length> address-x: address-box.absolute-position.x;
    out property <length> address-y: address-box.absolute-position.y;
    out property <length> address-width: address-box.width;
    out property <length> address-height: address-box.height;
    // The search-options button's place in the window, for its popup.
    out property <length> options-x: search-options-button.absolute-position.x;
    out property <length> options-y: search-options-button.absolute-position.y;
    out property <length> options-height: search-options-button.height;

    callback navigate(string);
    callback search(string);
    callback search-options-changed();
    callback row-expand(int);
    callback back();
    callback forward();
    callback up();
    callback refresh();
    callback tab-select(int);
    callback tab-close(int);
    callback tab-new();
    callback sort(int);
    callback row-pressed(int, KeyboardModifiers);
    callback row-clicked(int);
    callback row-middle(int);
    callback row-open(int);
    callback row-menu(int);
    callback row-hover(int);
    callback row-drag(int);
    callback blank-pressed(bool, bool);  // (right button, control held)
    callback rename-done(string, bool);
    callback new-folder();
    callback new-file();
    callback delete-selected();
    callback view-changed();
    callback place-open(string);
    callback place-add();
    callback place-remove(string);
    callback history(int);
    callback rubber-start(bool);
    callback rubber-move(length, length);
    callback rubber-end();
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();
    // `in-list` is true when the file list has focus; otherwise only global shortcuts apply.
    callback key(KeyEvent, bool) -> bool;
    callback suggest(string);
    callback suggest-cancel();

    public function close-suggestions() {
        root.suggestions = [];
        root.suggest-index = -1;
        root.suggest-cancel();
    }

    public function pick-suggestion(i: int) {
        if (i >= 0 && i < root.suggestions.length) {
            root.address-text = root.suggestions[i].path;
            root.address-editing = false;
            root.close-suggestions();
            root.navigate(root.address-text);
        }
    }

    public function focus-list() {
        root.search-options-open = false;
        root.address-editing = false;
        root.address-text = root.path;
        root.close-suggestions();
        list-focus.focus();
    }

    public function focus-address() {
        root.search-options-open = false;
        root.close-suggestions();
        root.address-editing = true;
        root.address-text = root.path;
        address.focus();
        address.select-all();
    }

    public function focus-search() {
        if (root.this-pc) {
            return;
        }
        root.search-options-open = false;
        root.address-editing = false;
        root.address-text = root.path;
        root.close-suggestions();
        search-box.focus();
        search-box.select-all();
    }

    private property <length> w-name: root.search-mode ? 280px : 440px;
    private property <length> w-location: 210px;
    private property <length> w-date: 150px;
    private property <length> w-kind: 130px;
    private property <length> w-size: 100px;
    private property <length> suggestion-row-height: 28px;
    // Explorer leaves a small strip on each side of the rows where a drag starts a
    // rubber-band selection instead of hitting a row.
    private property <length> list-margin: 6px;
    private property <brush> dim: Palette.foreground.transparentize(0.4);

    // The mouse's back/forward buttons work anywhere nothing more specific handles them.
    TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.back {
                root.history(-1);
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.forward {
                root.history(1);
            }
        }
    }

    FocusScope {
        key-pressed(e) => {
            root.key(e, false) ? EventResult.accept : EventResult.reject
        }

        VerticalLayout {
            // Tabs: the active one is joined to the page below it (same background, accent line,
            // bold title); the others sit back on the darker strip.
            Rectangle {
                height: 40px;
                background: Palette.alternate-background;
            // Drag the window from the empty part of the tab strip. Stop short of the
            // caption buttons so they own every pointer event in their corner.
            WindowMoveArea {
                width: parent.width - 138px;
                height: 100%;
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 138px;
                padding-top: 6px;
                spacing: 2px;
                alignment: start;
                for t[i] in root.tabs: Rectangle {
                    width: 200px;
                    border-top-left-radius: 8px;
                    border-top-right-radius: 8px;
                    background: i == root.active-tab ? Palette.background : tab-touch.has-hover ? Palette.foreground.transparentize(0.92) : transparent;
                    Rectangle {
                        x: 10px;
                        y: 0;
                        width: parent.width - 20px;
                        height: 2px;
                        border-radius: 1px;
                        background: i == root.active-tab ? Palette.accent-background : transparent;
                    }
                    tab-touch := TouchArea {
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                root.tab-select(i);
                            }
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.middle {
                                root.tab-close(i);
                            }
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.back {
                                root.history(-1);
                            }
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.forward {
                                root.history(1);
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 4px;
                        spacing: 6px;
                        Image {
                            width: 16px;
                            source: @image-url("assets/icon-32.png");
                            image-fit: contain;
                            opacity: i == root.active-tab ? 1 : 0.6;
                        }
                        Text {
                            text: t.title;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-weight: i == root.active-tab ? 600 : 400;
                            color: i == root.active-tab ? Palette.foreground : root.dim;
                        }
                        Rectangle {
                            width: 24px;
                            border-radius: 4px;
                            background: close-touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;
                            // Close button: always on the active tab, on hover for the others.
                            opacity: i == root.active-tab || tab-touch.has-hover || close-touch.has-hover ? 1 : 0;
                            Text {
                                text: "×";
                                font-size: 16px;
                                color: Palette.foreground;
                            }
                            close-touch := TouchArea {
                                clicked => {
                                    root.tab-close(i);
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    width: 32px;
                    border-radius: 6px;
                    background: new-touch.has-hover ? Palette.foreground.transparentize(0.95) : transparent;
                    Text {
                        text: "+";
                        font-size: 16px;
                        color: Palette.foreground;
                    }
                    new-touch := TouchArea {
                        clicked => {
                            root.tab-new();
                        }
                    }
                }
            }

            // Custom window controls (the native title bar is gone).
            Rectangle {
                x: parent.width - 138px;
                width: 138px;
                height: parent.height;
                background: Palette.alternate-background;
                HorizontalLayout {
                    WindowButton {
                        kind: CaptionGlyph.minimize;
                        clicked => {
                            root.window-minimize();
                        }
                    }
                    WindowButton {
                        kind: root.maximized ? CaptionGlyph.restore : CaptionGlyph.maximize;
                        clicked => {
                            root.window-toggle-maximize();
                        }
                    }
                    WindowButton {
                        kind: CaptionGlyph.close;
                        clicked => {
                            root.window-close();
                        }
                    }
                }
            }
            }

            // Navigation + address bar
            HorizontalLayout {
                padding: 6px;
                spacing: 4px;
                cross-axis-alignment: center;
                ToolButton {
                    text: "←";
                    font-size: 16px;
                    enabled: root.can-back;
                    clicked => {
                        root.back();
                    }
                }
                ToolButton {
                    text: "→";
                    font-size: 16px;
                    enabled: root.can-forward;
                    clicked => {
                        root.forward();
                    }
                }
                ToolButton {
                    text: "↑";
                    font-size: 16px;
                    clicked => {
                        root.up();
                    }
                }
                RefreshButton {
                    clicked => {
                        root.refresh();
                    }
                }
                address-box := Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    border-radius: 6px;
                    background: Palette.background;
                    border-width: 1px;
                    border-color: root.address-editing ? Palette.accent-background : Palette.foreground.transparentize(0.82);

                    address := LineEdit {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        text <=> root.address-text;
                        edited(t) => {
                            root.suggest(t);
                        }
                        accepted(t) => {
                            if (root.suggest-index >= 0) {
                                root.pick-suggestion(root.suggest-index);
                            } else {
                                root.address-editing = false;
                                root.close-suggestions();
                                root.navigate(t);
                            }
                        }
                        key-pressed(e) => {
                            if (root.suggestions.length > 0) {
                                if (e.text == Key.DownArrow) {
                                    root.suggest-index = root.suggest-index + 1 < root.suggestions.length ? root.suggest-index + 1 : 0;
                                    return accept;
                                }
                                if (e.text == Key.UpArrow) {
                                    root.suggest-index = root.suggest-index <= 0 ? root.suggestions.length - 1 : root.suggest-index - 1;
                                    return accept;
                                }
                                if (e.text == Key.Escape) {
                                    root.close-suggestions();
                                    return accept;
                                }
                            }
                            if e.text == Key.Escape {
                                root.address-editing = false;
                                root.address-text = root.path;
                                root.focus-list();
                                return accept;
                            }
                            reject
                        }
                        changed has-focus => {
                            if !self.has-focus && root.address-editing {
                                root.address-editing = false;
                                root.address-text = root.path;
                                root.close-suggestions();
                            }
                        }
                    }

                    // Folder buttons; the empty area switches to typing.
                    if !root.address-editing: Rectangle {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        border-radius: 5px;
                        background: Palette.background;
                        clip: true;

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: text;
                            clicked => {
                                root.focus-address();
                            }
                        }

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 0px;
                            alignment: start;

                            for c[i] in root.crumbs: HorizontalLayout {
                                spacing: 0px;
                                alignment: start;
                                if i > 0: Text {
                                    width: 14px;
                                    text: "\\";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    color: root.dim;
                                }
                                CrumbButton {
                                    title: c.title;
                                    clicked => {
                                        root.place-open(c.path);
                                    }
                                }
                            }
                        }
                    }
                }
                search-box := LineEdit {
                    width: 340px;
                    enabled: !root.this-pc;
                    placeholder-text: root.this-pc
                        ? "폴더에서만 검색"
                        : "검색 (현재+하위) · 공백 AND · ; OR";
                    text <=> root.search-text;
                    edited(t) => {
                        root.search(t);
                    }
                }
                search-options-button := KebabButton {
                    clicked => {
                        root.search-options-open = !root.search-options-open;
                    }
                }
            }

            // Sidebar + file list
            HorizontalLayout {
                vertical-stretch: 1;

                Sidebar {
                    width: 196px;
                    vertical-stretch: 1;
                    favorites: root.favorites;
                    drives: root.drives;
                    this-pc-path: root.this-pc-path;
                    this-pc-active: root.this-pc;
                    open(p) => {
                        root.place-open(p);
                    }
                    add => {
                        root.place-add();
                    }
                    remove(p) => {
                        root.place-remove(p);
                    }
                    history(d) => {
                        root.history(d);
                    }
                }
                Rectangle {
                    width: 1px;
                    background: Palette.border;
                }

                VerticalLayout {
                    // Command bar
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 4px;
                        spacing: 4px;
                        cross-axis-alignment: center;
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        CheckBox {
                            text: "숨긴 항목";
                            visible: !root.this-pc || root.search-mode;
                            checked <=> root.show-hidden;
                            changed checked => {
                                root.view-changed();
                            }
                        }
                        CheckBox {
                            text: "파일 확장명";
                            visible: !root.this-pc || root.search-mode;
                            checked <=> root.show-ext;
                            changed checked => {
                                root.view-changed();
                            }
                        }
                    }

                    // Column header
                    header-bar := Rectangle {
                        height: 28px;
                        clip: true;
                        HorizontalLayout {
                            padding-left: root.list-margin + 6px;
                            alignment: start;
                            name-header := HeaderCell {
                                width: root.w-name;
                                min-column-width: 120px;
                                max-column-width: max(120px, header-bar.width - root.list-margin - 7px);
                                fit-width: max(120px, measure-name.preferred-width + 34px);
                                text: "이름";
                                sorted: root.sort-column == 0;
                                descending: root.sort-desc;
                                clicked => {
                                    root.sort(0);
                                }
                                resize(w) => {
                                    root.w-name = w;
                                }
                                auto-fit => {
                                    root.w-name = min(name-header.max-column-width, name-header.fit-width);
                                }
                            }
                            if root.search-mode: location-header := HeaderCell {
                                width: root.w-location;
                                min-column-width: 90px;
                                max-column-width: max(90px, header-bar.width - root.list-margin - 7px - root.w-name);
                                fit-width: max(90px, measure-location.preferred-width + 24px);
                                text: "위치";
                                resize(w) => {
                                    root.w-location = w;
                                }
                                auto-fit => {
                                    root.w-location = min(location-header.max-column-width, location-header.fit-width);
                                }
                            }
                            date-header := HeaderCell {
                                width: root.w-date;
                                min-column-width: 100px;
                                max-column-width: max(100px, header-bar.width - root.list-margin - 7px - root.w-name - (root.search-mode ? root.w-location : 0px));
                                fit-width: max(100px, measure-date.preferred-width + 22px);
                                text: root.this-pc && !root.search-mode ? "여유 공간" : "수정한 날짜";
                                sorted: root.sort-column == 1;
                                descending: root.sort-desc;
                                clicked => {
                                    root.sort(1);
                                }
                                resize(w) => {
                                    root.w-date = w;
                                }
                                auto-fit => {
                                    root.w-date = min(date-header.max-column-width, date-header.fit-width);
                                }
                            }
                            kind-header := HeaderCell {
                                width: root.w-kind;
                                min-column-width: 70px;
                                max-column-width: max(70px, header-bar.width - root.list-margin - 7px - root.w-name - (root.search-mode ? root.w-location : 0px) - root.w-date);
                                fit-width: max(70px, measure-kind.preferred-width + 22px);
                                text: "유형";
                                sorted: root.sort-column == 2;
                                descending: root.sort-desc;
                                clicked => {
                                    root.sort(2);
                                }
                                resize(w) => {
                                    root.w-kind = w;
                                }
                                auto-fit => {
                                    root.w-kind = min(kind-header.max-column-width, kind-header.fit-width);
                                }
                            }
                            size-header := HeaderCell {
                                width: root.w-size;
                                min-column-width: 70px;
                                max-column-width: max(70px, header-bar.width - root.list-margin - 7px - root.w-name - (root.search-mode ? root.w-location : 0px) - root.w-date - root.w-kind);
                                fit-width: max(70px, measure-size.preferred-width + 22px);
                                text: root.this-pc && !root.search-mode ? "전체 용량" : "크기";
                                sorted: root.sort-column == 3;
                                descending: root.sort-desc;
                                clicked => {
                                    root.sort(3);
                                }
                                resize(w) => {
                                    root.w-size = w;
                                }
                                auto-fit => {
                                    root.w-size = min(size-header.max-column-width, size-header.fit-width);
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Palette.border;
                        }
                    }

                    // File list (virtualized: only visible rows are instantiated)
                    list-focus := FocusScope {
                        vertical-stretch: 1;
                        key-pressed(e) => {
                            root.key(e, true) ? EventResult.accept : EventResult.reject
                        }

                        // Clicks that no row takes land here: empty space below the rows.
                        blank-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    if e.button == PointerEventButton.left {
                                        list-focus.focus();
                                        root.blank-pressed(false, e.modifiers.control);
                                        root.rubber-start(e.modifiers.control);
                                        root.rubber-on = true;
                                    }
                                    if e.button == PointerEventButton.right {
                                        list-focus.focus();
                                        root.blank-pressed(true, false);
                                    }
                                    if e.button == PointerEventButton.back {
                                        root.history(-1);
                                    }
                                    if e.button == PointerEventButton.forward {
                                        root.history(1);
                                    }
                                }
                                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.rubber-on {
                                    root.rubber-on = false;
                                    root.rubber-end();
                                }
                            }
                            moved => {
                                if root.rubber-on {
                                    root.rubber-move(blank-touch.pressed-y, blank-touch.mouse-y);
                                }
                            }

                        list := ListView {
                            x: root.list-margin;
                            width: parent.width - 2 * root.list-margin;
                            height: 100%;
                            for r[i] in root.rows: Rectangle {
                                height: root.row-height;
                                background: i == root.drop-row ? Palette.accent-background.transparentize(0.6) : r.selected ? Palette.accent-background.transparentize(list-focus.has-focus ? 0.75 : 0.88) : row-touch.has-hover ? Palette.foreground.transparentize(0.95) : transparent;

                                row-touch := TouchArea {
                                    pointer-event(e) => {
                                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                            list-focus.focus();
                                            root.row-pressed(i, e.modifiers);
                                        }
                                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                                            list-focus.focus();
                                            root.row-menu(i);
                                        }
                                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.middle {
                                            list-focus.focus();
                                            root.row-middle(i);
                                        }
                                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.back {
                                            root.history(-1);
                                        }
                                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.forward {
                                            root.history(1);
                                        }
                                    }
                                    moved => {
                                        if abs(self.mouse-x - self.pressed-x) > 5px || abs(self.mouse-y - self.pressed-y) > 5px {
                                            root.row-drag(i);
                                        }
                                    }
                                    clicked => {
                                        root.row-clicked(i);
                                    }
                                    double-clicked => {
                                        root.row-open(i);
                                    }
                                    // Prefetch the shell menu for the item under the mouse.
                                    changed has-hover => {
                                        if self.has-hover {
                                            root.row-hover(i);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    alignment: start;
                                    private property <length> tree-indent: root.search-mode ? (14px + r.depth * 14px) : 0px;
                                    if root.search-mode: Rectangle {
                                        width: r.depth * 14px;
                                    }
                                    if root.search-mode: Rectangle {
                                        width: 14px;
                                        height: 100%;
                                        Text {
                                            text: !r.expandable ? "" : r.expanded ? "▾" : "▸";
                                            font-size: 9px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            color: root.dim;
                                        }
                                        if r.expandable: TouchArea {
                                            clicked => {
                                                list-focus.focus();
                                                root.row-expand(i);
                                            }
                                        }
                                    }
                                    Image {
                                        width: 16px;
                                        source: r.icon;
                                        image-fit: contain;
                                    }
                                    Rectangle {
                                        width: 6px;
                                    }
                                    if !r.editing: Text {
                                        width: max(0px, root.w-name - 22px - tree-indent);
                                        text: r.name;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        color: Palette.foreground;
                                    }
                                    if r.editing: LineEdit {
                                        width: max(0px, root.w-name - 22px - tree-indent);
                                        text: r.name;
                                        init => {
                                            self.focus();
                                            self.set-selection-offsets(0, r.stem);
                                        }
                                        accepted(t) => {
                                            root.rename-done(t, true);
                                        }
                                        key-pressed(e) => {
                                            if e.text == Key.Escape {
                                                root.rename-done("", false);
                                                return accept;
                                            }
                                            reject
                                        }
                                        changed has-focus => {
                                            if !self.has-focus {
                                                root.rename-done(self.text, true);
                                            }
                                        }
                                    }
                                    if root.search-mode: Text {
                                        width: root.w-location;
                                        text: r.location;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        color: root.dim;
                                    }
                                    Rectangle {
                                        width: root.w-date;
                                        height: parent.height;

                                        Text {
                                            x: 0;
                                            y: 0;
                                            width: parent.width;
                                            height: parent.height - 4px;
                                            text: r.date;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            color: root.dim;
                                        }
                                        if r.usage >= 0.0: Rectangle {
                                            y: parent.height - 4px;
                                            height: 3px;
                                            width: parent.width;
                                            background: Palette.foreground.transparentize(0.88);
                                            border-radius: 1.5px;
                                        }
                                        if r.usage >= 0.0: Rectangle {
                                            y: parent.height - 4px;
                                            height: 3px;
                                            width: parent.width * r.usage;
                                            background: Palette.accent-background;
                                            border-radius: 1.5px;
                                        }
                                    }
                                    Text {
                                        width: root.w-kind;
                                        text: r.kind;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        color: root.dim;
                                    }
                                    Text {
                                        width: root.w-size;
                                        text: r.size;
                                        overflow: elide;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        color: root.dim;
                                    }
                                }
                            }
                        }

                        // Rubber-band selection rectangle.
                        Rectangle {
                            visible: root.rubber-on;
                            x: min(blank-touch.pressed-x, blank-touch.mouse-x);
                            y: min(blank-touch.pressed-y, blank-touch.mouse-y);
                            width: abs(blank-touch.mouse-x - blank-touch.pressed-x);
                            height: abs(blank-touch.mouse-y - blank-touch.pressed-y);
                            background: Palette.accent-background.transparentize(0.85);
                            border-width: 1px;
                            border-color: Palette.accent-background;
                        }
                        }
                    }
                }
            }

            // Status bar
            HorizontalLayout {
                padding: 6px;
                padding-left: 10px;
                Text {
                    text: root.status;
                    color: root.dim;
                }
            }
        }

        // Address-bar autocomplete; a later sibling draws above the page.
        if (root.address-editing && root.suggestions.length > 0): Rectangle {
            x: root.address-x;
            y: min(
                root.address-y + root.address-height + 2px,
                root.height - root.suggestions.length * root.suggestion-row-height - 16px,
            );
            width: root.address-width;
            height: root.suggestions.length * root.suggestion-row-height + 8px;
            background: Palette.background;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.foreground.transparentize(0.75);
            clip: true;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                for s[i] in root.suggestions: Rectangle {
                    height: root.suggestion-row-height;
                    border-radius: 4px;
                    background: i == root.suggest-index
                        ? Palette.accent-background.transparentize(0.65)
                        : suggest-touch.has-hover ? Palette.foreground.transparentize(0.94) : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            width: 240px;
                            text: s.name;
                            overflow: elide;
                            vertical-alignment: center;
                            color: Palette.foreground;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: s.detail;
                            overflow: elide;
                            vertical-alignment: center;
                            color: root.dim;
                        }
                    }

                    suggest-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            root.pick-suggestion(i);
                        }
                    }
                }
            }
        }

        // Search options: a small menu anchored under the kebab button.
        if root.search-options-open: TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.search-options-open = false;
            }
        }

        if root.search-options-open: Rectangle {
            x: max(8px, min(root.options-x + search-options-button.width - 228px, root.width - 228px));
            y: root.options-y + root.options-height + 4px;
            width: 220px;
            height: options-panel.preferred-height + 20px;
            background: Palette.background;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.foreground.transparentize(0.65);
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000038;
            drop-shadow-offset-y: 4px;
            clip: true;

            options-panel := VerticalLayout {
                padding: 10px;
                spacing: 5px;

                Text { text: "검색 옵션"; font-size: 13px; color: Palette.foreground; }
                Rectangle { height: 2px; }

                Text { text: "검색 대상"; font-size: 12px; color: root.dim; }
                CheckBox {
                    text: "폴더";
                    checked <=> root.search-folders;
                    changed checked => {
                        root.search-options-changed();
                    }
                }
                CheckBox {
                    text: "파일";
                    checked <=> root.search-files;
                    changed checked => {
                        root.search-options-changed();
                    }
                }

                Rectangle { height: 4px; }

                Text { text: "패턴"; font-size: 12px; color: root.dim; }
                CheckBox {
                    text: "정규식";
                    checked <=> root.search-regex;
                    changed checked => {
                        root.search-options-changed();
                    }
                }

                Rectangle { height: 4px; }

                Text { text: "결과 보기"; font-size: 12px; color: root.dim; }
                OptionChoice {
                    text: "단순 목록";
                    selected: root.search-view == 0;
                    clicked => {
                        root.search-view = 0;
                        root.search-options-changed();
                    }
                }
                OptionChoice {
                    text: "트리 구조";
                    selected: root.search-view == 1;
                    clicked => {
                        root.search-view = 1;
                        root.search-options-changed();
                    }
                }
            }
        }

        // Off-screen samples for "fit column to contents" (double-click a header divider).
        // Measuring with real Text elements keeps the fit identical to what the rows render.
        Rectangle {
            x: -10000px;
            y: 0px;
            width: 5000px;
            height: 24px;
            opacity: 0;
            clip: true;

            HorizontalLayout {
                alignment: start;
                measure-name := Text {
                    text: root.fit-name;
                }
                measure-location := Text {
                    text: root.fit-location;
                }
                measure-date := Text {
                    text: root.fit-date;
                }
                measure-kind := Text {
                    text: root.fit-kind;
                }
                measure-size := Text {
                    text: root.fit-size;
                }
            }
        }

        // A crisp frame so the window reads as a separate surface. The native DWM
        // frame underneath adds the outer drop shadow.
        Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;
            border-width: 1px;
            border-color: root.maximized ? transparent : Palette.foreground.transparentize(0.6);
        }
    }

    // The left click that dismissed a native context menu: swallow it so a stale pointer
    // position cannot select, open, or start a drag behind the menu.
    if root.click-shield: TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(e) => {
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                root.click-shield = false;
            }
        }
    }
}
